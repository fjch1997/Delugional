<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    
    <!-- NuGet Package Properties -->
    <PackageId>Delugional</PackageId>
    <Version>2.0.0</Version>
    <Authors>Ryan Esteves</Authors>
    <Company>Delugional</Company>
    <Description>A .NET library for interacting with the Deluge BitTorrent client via RPC.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/snargledorf/Delugional</PackageProjectUrl>
    <RepositoryUrl>https://github.com/snargledorf/Delugional</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>deluge;bittorrent;torrent;rpc</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(MSBuildProjectName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="rencode-sharp" Version="1.0.7" />
    <PackageReference Include="System.Management" Version="10.0.3" />
  </ItemGroup>

</Project>
